root = "~/mail"
spool = "inbox"
sent = "sent"
drafts = "drafts"
trash = "trash"
editor = "vim"
sendmail = "/usr/sbin/sendmail"
identities = ["User <user@example.com>"]

[index]
format = "{date:12} {flags:4} {sender:20}  {subject:*}"

# Key tables override defaults. Object entries pass modifiers to their action.
[keys.index]
"^N" = "down"
"^P" = "up"
PAGEUP = "pageup"
PAGEDOWN = "pagedown"
R = { action = "refresh", before = "mbsync {maildir}" }
q = ""

[keys.message]
q = "back"

[keys.parts]
s = "save"

[keys.pager]
HOME = "home"
END = "end"

[keys.choice]
ENTER = "accept"
